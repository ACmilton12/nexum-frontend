<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Archivos estáticos existentes (JS, CSS, imágenes)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React Router: cualquier ruta → index.html
    RewriteRule ^ index.html [L]
</IfModule>
